# Enquiry form delivery. Copy to .env (local) or add in Vercel > Project > Settings > Environment Variables.
# Any service that accepts a JSON POST and returns 2xx on success works, e.g. a Formspree form endpoint:
#   PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
# Leave empty and the form tells visitors honestly that enquiries are not connected yet.
PUBLIC_FORM_ENDPOINT=
