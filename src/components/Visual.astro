---
/** A rendered study-model still with a mask reveal and a discreet "Illustrative visual" label. */
interface Props {
  src: string; // path without the -1200.webp / -2400.webp suffix
  alt: string;
  ratio: string;
  full?: boolean;
}
const { src, alt, ratio, full = false } = Astro.props;
---

<figure class={`visual ${full ? 'visual-full' : ''}`} data-visual>
  <div class="visual-frame" style={`aspect-ratio:${ratio}`}>
    <img
      src={`${src}-1200.webp`}
      srcset={`${src}-1200.webp 1200w, ${src}-2400.webp 2400w`}
      sizes={full ? '100vw' : '(min-width: 900px) 50vw, 100vw'}
      alt={alt}
      loading="lazy"
      decoding="async"
      data-visual-img
    />
  </div>
  <figcaption class="tag">Illustrative visual</figcaption>
</figure>
